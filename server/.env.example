# `claude setup-token`으로 새 장기 토큰을 만든 뒤 배포 서비스의 Secret에 저장합니다.
CLAUDE_CODE_OAUTH_TOKEN=

# 브라우저에서 Claude 브리지에 접속할 때 입력할 별도의 긴 키입니다.
# 20자 이상의 무작위 값을 권장합니다. admin1234를 재사용하지 마세요.
CLAUDE_BRIDGE_ACCESS_KEY=

# 쉼표로 여러 Origin을 구분할 수 있습니다. 경로는 넣지 않습니다.
ALLOWED_ORIGINS=https://morningcandy.github.io

PORT=8080
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MS=120000
